<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <name>GoogleCalendar</name>
    <description>Create, Delete, Update event in Google Calendar</description>
    <groupId>org.camunda.connector</groupId>
    <artifactId>connector-google-calendar</artifactId>
    <packaging>jar</packaging>
    <!-- 1.0.0 -->
    <!-- 1.1.0 Normalize groupId and artefact id -->
    <version>1.1.0</version>

    <properties>
        <maven.compiler.release>23</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>


        <!-- connector SDK version -->
        <!-- connector SDK version 8.8.7 / 8.7.8 / 8.8.7 -->
        <version.connector>8.10.0</version.connector>


        <version.opensagres>2.0.4</version.opensagres>

        <!-- external libraries -->
        <version.slf4j>2.0.12</version.slf4j>
        <version.jackson>2.17.0</version.jackson>
        <version.assertj>3.27.3</version.assertj>
        <version.junit-jupiter>5.12.1</version.junit-jupiter>
        <version.mockito>5.16.1</version.mockito>
        <java.version>23</java.version>
        <maven.compiler.source>23</maven.compiler.source>
        <maven.compiler.target>23</maven.compiler.target>
    </properties>

    <!-- Push the library to Maven -->
    <!-- Visit https://github.com/camunda-community-hub/community-action-maven-release -->
    <parent>
        <groupId>org.camunda.community</groupId>
        <artifactId>community-hub-release-parent</artifactId>
        <version>2.1.1</version>
    </parent>


    <dependencies>
        <dependency>
            <groupId>io.camunda.connector</groupId>
            <artifactId>connector-core</artifactId>
            <version>${version.connector}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>io.camunda.connector</groupId>
            <artifactId>element-template-generator-core</artifactId>
            <version>${version.connector}</version>
        </dependency>


        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-scala_2.13</artifactId>
            <version>2.17.0</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${version.slf4j}</version>
        </dependency>

        <!-- Access file  -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.27</version>
        </dependency>

        <dependency>
            <groupId>org.freemarker</groupId>
            <artifactId>freemarker</artifactId>
            <version>2.3.31</version>
        </dependency>


        <!-- test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${version.junit-jupiter}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${version.mockito}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${version.assertj}</version>
            <scope>test</scope>
        </dependency>


        <!-- for testing connectors locally in bundle with runtime -->


        <dependency>
            <groupId>io.camunda.connector</groupId>
            <artifactId>spring-boot-starter-camunda-connectors</artifactId>
            <version>${version.connector}</version>
<!--            <scope>test</scope> -->
        </dependency>

        <!-- to generate the element-template -->

        <dependency>
            <groupId>io.camunda.community</groupId>
            <artifactId>zeebe-cherry-runtime</artifactId>
            <!-- 3.5.0's SdkRunnerCherryConnector required a 2-arg (function, ZeebeContainer) constructor;
                 3.5.2 reverted to the 1-arg constructor that DocumentationGenerator.java calls. -->
            <version>3.5.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Google Calendar API -->
        <dependency>
            <groupId>com.google.apis</groupId>
            <artifactId>google-api-services-calendar</artifactId>
            <version>v3-rev20260517-2.0.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.auth</groupId>
            <artifactId>google-auth-library-oauth2-http</artifactId>
            <version>1.23.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.http-client</groupId>
            <artifactId>google-http-client-gson</artifactId>
            <version>1.44.1</version>
        </dependency>

    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.camunda</groupId>
                <artifactId>camunda-bom</artifactId>
                <version>8.8.0</version>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <resources>
            <!-- Solve the project.version in the banner.txt -->
            <!-- spring-boot-starter-parent : delimiter is @@ -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <!-- spring-boot-starter-parent auto-binds spring-boot-maven-plugin's "repackage" goal
                 to the package phase, which fat-ifies the main artifact and renames the original
                 thin jar to original-*.jar - independently of, and conflicting with, the
                 with-dependencies shade execution below. Disable it so the plain jar stays
                 untouched (own classes only). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <!-- spring-boot-starter-parent also pre-configures an unnamed ("default")
                         execution of this same plugin bound to the package phase, which repackages
                         the main jar into a Spring-Boot-style fat jar. Disable it so it doesn't
                         fight with "with-dependencies" below and fat-ify the plain jar. -->
                    <execution>
                        <id>default</id>
                        <phase>none</phase>
                    </execution>
                    <!-- "with-dependencies": a convenience jar for local use (upload to a Connector
                         Runtime or Cherry instance by hand). The host already provides Spring Boot
                         and the whole Camunda connector/client/FEEL stack (and its own transitive
                         libraries: gRPC/Netty, protobuf, v5 httpcomponents, Jackson, Apache
                         Commons, BouncyCastle, etc.), so this excludes all of that by groupId -
                         but keeps this connector's own Google Calendar API client libraries
                         (com.google.apis, com.google.api-client, com.google.oauth-client,
                         com.google.auth, com.google.http-client, pdfbox, freemarker), since the
                         host does NOT supply those.
                         A few groupIds overlap with the host's own stack but are needed here in a
                         DIFFERENT flavor/role than the host uses, so they are deliberately left
                         bundled rather than excluded (same reasoning as pdf's filestorage/CMIS
                         overlap):
                           - org.apache.httpcomponents (v4, no suffix) / commons-codec: required
                             transitively by google-api-client's HTTP transport. The host only
                             supplies the v5 transport (.client5/.core5 below), which is excluded
                             separately and does not satisfy this need.
                           - com.google.guava, com.google.http-client, io.opencensus,
                             com.google.j2objc, com.google.auto.value, com.google.code.findbugs,
                             com.google.errorprone: required transitively by
                             google-auth-library-oauth2-http / google-http-client. The host's own
                             gRPC stack does not pull these into this project's tree, so there is
                             no host-provided copy to rely on.
                         Excluding any of the above would break the Google Calendar client at
                         runtime for a small reduction in jar size, so they stay bundled. -->
                    <execution>
                        <id>with-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedClassifierName>with-dependencies</shadedClassifierName>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <artifactSet>
                                <excludes>
                                    <!-- Camunda connector/client/FEEL stack.
                                         NOT a groupId wildcard for io.camunda.connector: this project's OWN
                                         groupId is also io.camunda.connector (same as the host SDK), so a
                                         blanket io.camunda.connector:* exclude would also strip this
                                         project's own compiled classes out of the jar (confirmed empirically -
                                         verify with: unzip -l target/*-with-dependencies.jar | grep <own pkg>).
                                         Exclude only the specific host SDK artifactIds instead. -->
                                    <exclude>io.camunda.connector:connector-core</exclude>
                                    <exclude>io.camunda.connector:connector-runtime-core</exclude>
                                    <exclude>io.camunda.connector:connector-runtime-spring</exclude>
                                    <exclude>io.camunda.connector:connector-utils</exclude>
                                    <exclude>io.camunda.connector:connector-validation</exclude>
                                    <exclude>io.camunda.connector:connector-object-mapper</exclude>
                                    <exclude>io.camunda.connector:connector-feel-wrapper</exclude>
                                    <exclude>io.camunda.connector:jackson-datatype-document</exclude>
                                    <exclude>io.camunda.connector:jackson-datatype-feel</exclude>
                                    <exclude>io.camunda.connector:element-template-generator-core</exclude>
                                    <exclude>io.camunda.connector:http-client</exclude>
                                    <exclude>io.camunda.connector:spring-boot-starter-camunda-connectors</exclude>
                                    <exclude>io.camunda:*</exclude>
                                    <exclude>org.camunda.feel:*</exclude>
                                    <exclude>org.camunda.bpm.model:*</exclude>
                                    <!-- Spring Boot / Spring Framework -->
                                    <exclude>org.springframework.boot:*</exclude>
                                    <exclude>org.springframework:*</exclude>
                                    <exclude>ch.qos.logback:*</exclude>
                                    <exclude>org.apache.logging.log4j:*</exclude>
                                    <exclude>org.slf4j:*</exclude>
                                    <exclude>org.apache.tomcat.embed:*</exclude>
                                    <exclude>io.micrometer:*</exclude>
                                    <exclude>org.hibernate.validator:*</exclude>
                                    <exclude>org.jboss.logging:*</exclude>
                                    <exclude>com.fasterxml:classmate</exclude>
                                    <exclude>org.yaml:*</exclude>
                                    <!-- gRPC / Netty (Zeebe gateway transport) -->
                                    <exclude>io.grpc:*</exclude>
                                    <exclude>io.netty:*</exclude>
                                    <exclude>com.google.protobuf:*</exclude>
                                    <exclude>com.google.api.grpc:*</exclude>
                                    <!-- Camunda's OWN http-client transport only (v5) - NOT the v4
                                         org.apache.httpcomponents (no suffix) that
                                         google-api-client needs, which stays bundled. -->
                                    <exclude>org.apache.httpcomponents.client5:*</exclude>
                                    <exclude>org.apache.httpcomponents.core5:*</exclude>
                                    <!-- Jackson (host-provided; this connector's own
                                         jackson-module-scala_2.13 dependency is unused leftover) -->
                                    <exclude>com.fasterxml.jackson.core:*</exclude>
                                    <exclude>com.fasterxml.jackson.dataformat:*</exclude>
                                    <exclude>com.fasterxml.jackson.datatype:*</exclude>
                                    <exclude>com.fasterxml.jackson.module:*</exclude>
                                    <exclude>com.fasterxml.uuid:*</exclude>
                                    <!-- Scala (FEEL engine + the project's own unused jackson-module-scala) -->
                                    <exclude>org.scala-lang:*</exclude>
                                    <exclude>com.lihaoyi:*</exclude>
                                    <!-- Misc transitive libraries used only by the Camunda/Spring stack -->
                                    <exclude>com.auth0:*</exclude>
                                    <exclude>dev.failsafe:*</exclude>
                                    <exclude>jakarta.annotation:*</exclude>
                                    <exclude>jakarta.validation:*</exclude>
                                    <exclude>io.pebbletemplates:*</exclude>
                                    <exclude>net.steppschuh.markdowngenerator:*</exclude>
                                    <exclude>org.apache.commons:*</exclude>
                                    <exclude>org.bouncycastle:*</exclude>
                                    <exclude>org.codehaus.mojo:animal-sniffer-annotations</exclude>
                                    <exclude>org.unbescape:*</exclude>
                                    <exclude>uk.co.jemos.podam:*</exclude>
                                    <exclude>org.jetbrains:annotations</exclude>
                                </excludes>
                            </artifactSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>

        <repository>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
            <id>connectors</id>
            <name>Connectors Repository</name>
            <url>https://artifacts.camunda.com/artifactory/connectors/</url>
        </repository>

        <repository>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
            <id>connectors-snapshots</id>
            <name>Connectors Snapshot Repository</name>
            <url>https://artifacts.camunda.com/artifactory/connectors-snapshots/</url>
        </repository>


    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>connectors</id>
            <name>Connectors Repository</name>
            <url>https://artifacts.camunda.com/artifactory/connectors/</url>
        </pluginRepository>

        <pluginRepository>
            <id>connectors-snapshots</id>
            <name>Connectors Snapshot Repository</name>
            <url>https://artifacts.camunda.com/artifactory/connectors-snapshots/</url>
        </pluginRepository>
    </pluginRepositories>


    <profiles>
        <!-- This project has no .github/workflows release pipeline today, so this profile is never
             activated automatically. It's added anyway so that if/when a release pipeline is added
             using the standard community-action-maven-release action (its default release-profile
             id - see involvedusers' deploy.yml for the working reference), the with-dependencies
             shade execution is already correctly scoped out of the Central release from day one. -->
        <profile>
            <id>community-action-maven-release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>with-dependencies</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
